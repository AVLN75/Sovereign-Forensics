nt;font-weight:400;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre;white-space:pre-wrap;\"\u003emkdir -p \u0026quot;$MOUNT_POINT\u0026quot;\u003c/span\u003e\u003c/p\u003e\u003cp dir=\"ltr\" style=\"line-height:1.38;margin-top:0.0pt;margin-bottom:0.0pt;\"\u003e\u003cspan style=\"font-size:7.2pt;font-family:\u0027Google Sans\u0027;color:#000000;background-color:transparent;font-weight:400;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre;white-space:pre-wrap;\"\u003esudo mount \u0026quot;$PARTITION_DEVICE\u0026quot; \u0026quot;$MOUNT_POINT\u0026quot;\u003c/span\u003e\u003c/p\u003e\u003cbr /\u003e\u003cp dir=\"ltr\" style=\"line-height:1.38;margin-top:0.0pt;margin-bottom:0.0pt;\"\u003e\u003cspan style=\"font-size:7.2pt;font-family:\u0027Google Sans\u0027;color:#000000;background-color:transparent;font-weight:400;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre;white-space:pre-wrap;\"\u003e# 5. Use the mounted file system (example: create a file)\u003c/span\u003e\u003c/p\u003e\u003cp dir=\"ltr\" style=\"line-height:1.38;margin-top:0.0pt;margin-bottom:0.0pt;\"\u003e\u003cspan style=\"font-size:7.2pt;font-family:\u0027Google Sans\u0027;color:#000000;background-color:transparent;font-weight:400;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre;white-space:pre-wrap;\"\u003eecho \u0026quot;Creating a test file...\u0026quot;\u003c/span\u003e\u003c/p\u003e\u003cp dir=\"ltr\" style=\"line-height:1.38;margin-top:0.0pt;margin-bottom:0.0pt;\"\u003e\u003cspan style=\"font-size:7.2pt;font-family:\u0027Google Sans\u0027;color:#000000;background-color:transparent;font-weight:400;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre;white-space:pre-wrap;\"\u003esudo touch \u0026quot;$MOUNT_POINT/testfile.txt\u0026quot;\u003c/span\u003e\u003c/p\u0